BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Desarrollo local (SQLite)
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:finanzas-pyme.db
AUTH_DATABASE_PATH=finanzas-pyme.db
# En despliegue reemplaza las tres líneas anteriores por:
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://user:password@host:5432/deciflujo?sslmode=require
# DATABASE_POOL_MAX=10
RESEND_API_KEY=re_replace-with-your-api-key
RESEND_FROM_EMAIL=Deciflujo <no-reply@your-verified-domain.com>
# Opcional: dirección que recibirá las respuestas de los usuarios.
RESEND_REPLY_TO=soporte@your-verified-domain.com
# Monitoreo opcional. Sin DSN, Sentry permanece inactivo.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
