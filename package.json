{
  "name": "deciflujo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:auth:migrate": "npx --yes @better-auth/cli@1.4.21 migrate --yes --config better-auth.config.ts",
    "db:backup": "bash scripts/db/backup-postgres.sh",
    "db:restore": "bash scripts/db/restore-postgres.sh",
    "db:import-sqlite": "node scripts/db/import-sqlite-to-postgres.mjs",
    "check:production-env": "node scripts/validate-production-env.mjs",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:e2e": "LD_LIBRARY_PATH=${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$PWD/.playwright-deps/usr/lib/x86_64-linux-gnu playwright test",
    "test:e2e:deps": "bash scripts/testing/install-playwright-libs.sh"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@sentry/nextjs": "^10.69.0",
    "better-auth": "^1.6.25",
    "lucide-react": "^1.27.0",
    "next": "16.4.5",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "glob": "^14.0.2",
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    }
  }
}
